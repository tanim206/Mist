                {
                  "key": "attributes",
                  "value": "[{\"name\": \"Brand\", \"value\": \"Sony\"}, {\"name\": \"Color\", \"value\": \"Black\"}, {\"name\": \"Connectivity\", \"value\": \"Bluetooth 5.2\"}, {\"name\": \"Battery Life\", \"value\": \"30 hours\"}]",
