                {
                  "key": "variants",
                  "value": "[{\"sku\": \"WH-1000XM5-BLK-STD\", \"price\": 399.99, \"discountPrice\": 349.99, \"stock\": 50, \"options\": [{\"name\": \"Model\", \"value\": \"Standard\"}]}]",
                  "type": "text",
                  "description": "JSON array of product variants with options (optional)"
