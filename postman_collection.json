                {
                  "key": "videos",
                  "value": "[{\"videoUrl\": \"https://example.com/video.mp4\", \"thumbnailUrl\": \"https://example.com/thumb.jpg\", \"isPrimary\": true}]",
                  "type": "text",
                  "description": "JSON array of product videos (optional)"
                }
              ]
            },
            "description": "Create a new product with optional images, attributes, variants, and videos. Send as multipart/form-data."
          },
          "response": []
        },
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=10&sortBy=createdAt&sortOrder=desc&status=ACTIVE&categoryId={{categoryId}}&searchTerm=headphone",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "sortBy",
                  "value": "createdAt"
                },
                {
                  "key": "sortOrder",
                  "value": "desc"
                },
                {
                  "key": "status",
                  "value": "ACTIVE",
                  "description": "Filter by status: DRAFT, ACTIVE, INACTIVE, ARCHIVED"
                },
                {
                  "key": "categoryId",
                  "value": "{{categoryId}}",
                  "description": "Filter by category UUID"
                },
                {
                  "key": "searchTerm",
                  "value": "headphone",
                  "description": "Search in name, slug, sku, description"
                }
              ]
            },
            "description": "Get paginated list of products with filtering, sorting, and search"
          },
          "response": []
        },
