{
  "info": {
    "name": "E-Commerce API",
    "description": "Complete API collection for E-Commerce backend - Category & Product modules",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "1"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "",
      "type": "string",
      "description": "Set after creating a category"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string",
      "description": "Set after creating a product"
    }
  ],
  "item": [
    {
      "name": "Category",
      "item": [
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Electronics",
                  "type": "text",
                  "description": "Category name (required)"
                },
                {
                  "key": "slug",
                  "value": "electronics",
                  "type": "text",
                  "description": "URL slug (optional, auto-generated from name)"
                },
                {
                  "key": "description",
                  "value": "Electronic devices and accessories",
                  "type": "text",
                  "description": "Category description (optional, max 500 chars)"
                },
                {
                  "key": "status",
                  "value": "ACTIVE",
                  "type": "text",
                  "description": "Status: ACTIVE, INACTIVE (default: ACTIVE)"
                },
                {
                  "key": "image",
                  "value": "",
                  "type": "file",
                  "description": "Category image (optional, single file)"
                }
              ]
            },
            "description": "Create a new category with optional image. Send as multipart/form-data."
          },
          "response": []
        },
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories?page=1&limit=10&sortBy=createdAt&sortOrder=desc&status=ACTIVE&searchTerm=electro",
              "host": ["{{baseUrl}}"],
              "path": ["categories"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "sortBy",
                  "value": "createdAt"
                },
                {
                  "key": "sortOrder",
                  "value": "desc"
                },
                {
                  "key": "status",
                  "value": "ACTIVE",
                  "description": "Filter by status: ACTIVE, INACTIVE"
                },
                {
                  "key": "searchTerm",
                  "value": "electro",
                  "description": "Search in name, slug, description"
                }
              ]
            },
            "description": "Get paginated list of categories with filtering, sorting, and search"
          },
          "response": []
        },
        {
          "name": "Get Category by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["categories", "{{categoryId}}"]
            },
            "description": "Get single category by ID"
          },
          "response": []
        },
        {
          "name": "Get Category by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/slug/electronics",
              "host": ["{{baseUrl}}"],
              "path": ["categories", "slug", "electronics"]
            },
            "description": "Get single category by slug"
          },
          "response": []
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["categories", "{{categoryId}}"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Electronics & Gadgets",
                  "type": "text",
                  "description": "Category name (optional)"
                },
                {
                  "key": "slug",
                  "value": "electronics-gadgets",
                  "type": "text",
                  "description": "Slug (optional)"
                },
                {
                  "key": "description",
                  "value": "Updated description for electronics and gadgets",
                  "type": "text",
                  "description": "Description (optional)"
                },
                {
                  "key": "status",
                  "value": "ACTIVE",
                  "type": "text",
                  "description": "Status: ACTIVE, INACTIVE (optional)"
                },
                {
                  "key": "image",
                  "value": "",
                  "type": "file",
                  "description": "New category image (optional, replaces existing)"
                }
              ]
            },
            "description": "Update category. All fields optional. Providing image will replace existing one."
          },
          "response": []
        },
        {
          "name": "Delete Category (Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["categories", "{{categoryId}}"]
            },
            "description": "Soft delete category (sets deletedAt). Also deletes associated image from Cloudinary."
          },
          "response": []
        }
      ]
    },
    {
