{
  "info": {
    "name": "E-Commerce Category API",
    "description": "Category management endpoints - slug auto-generates from name if not provided",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "1"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "",
      "type": "string",
      "description": "Set after creating a category"
    }
  ],
  "item": [
    {
      "name": "Create Category (Auto Slug)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/categories",
          "host": ["{{baseUrl}}"],
          "path": ["categories"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Electronics & Gadgets\",\n  \"description\": \"Electronic devices and accessories\",\n  \"category_image\": \"https://example.com/electronics.jpg\",\n  \"category_imagePublic_Id\": \"electronics-banner\",\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Slug auto-generated', () => {",
              "  const res = pm.response.json();",
              "  pm.expect(res.data.slug).to.equal('electronics-gadgets');",
              "  pm.collectionVariables.set('categoryId', res.data.categoryId);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "Create Category (Custom Slug)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/categories",
          "host": ["{{baseUrl}}"],
          "path": ["categories"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Men's Fashion\",\n  \"slug\": \"mens-fashion-custom\",\n  \"description\": \"Men's clothing and accessories\",\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Get All Categories",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categories?page=1&limit=10&sortBy=createdAt&sortOrder=desc&status=ACTIVE",
          "host": ["{{baseUrl}}"],
          "path": ["categories"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "sortBy",
              "value": "createdAt"
            },
            {
              "key": "sortOrder",
              "value": "desc"
            },
            {
              "key": "status",
              "value": "ACTIVE"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Search Categories",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categories?searchTerm=electronics&page=1&limit=5",
          "host": ["{{baseUrl}}"],
          "path": ["categories"],
          "query": [
            {
              "key": "searchTerm",
              "value": "electronics"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Category by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categories/{{categoryId}}",
          "host": ["{{baseUrl}}"],
          "path": ["categories", "{{categoryId}}"]
        }
      },
      "response": []
    },
    {
      "name": "Get Category by Slug",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categories/slug/electronics-gadgets",
          "host": ["{{baseUrl}}"],
          "path": ["categories", "slug", "electronics-gadgets"]
        }
      },
      "response": []
    },
    {
      "name": "Update Category (Auto Slug from Name)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/categories/{{categoryId}}",
          "host": ["{{baseUrl}}"],
          "path": ["categories", "{{categoryId}}"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Electronics & Smart Gadgets\",\n  \"description\": \"Updated: Electronic devices, smart gadgets and accessories\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Slug updated from name', () => {",
              "  const res = pm.response.json();",
              "  pm.expect(res.data.slug).to.equal('electronics-smart-gadgets');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "Update Category (Custom Slug)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/categories/{{categoryId}}",
          "host": ["{{baseUrl}}"],
          "path": ["categories", "{{categoryId}}"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Electronics & Smart Gadgets\",\n  \"slug\": \"electronics-smart-devices\",\n  \"description\": \"Updated with custom slug\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Delete Category",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categories/{{categoryId}}",
          "host": ["{{baseUrl}}"],
          "path": ["categories", "{{categoryId}}"]
        }
      },
      "response": []
    },
    {
      "name": "Error: Duplicate Name",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/categories",
          "host": ["{{baseUrl}}"],
          "path": ["categories"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Electronics & Smart Gadgets\",\n  \"description\": \"This will fail - duplicate name\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Error: Missing Name",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/categories",
          "host": ["{{baseUrl}}"],
          "path": ["categories"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Missing required name field\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    }
  ]
}